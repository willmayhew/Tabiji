# Normalise line endings: store LF in the repository, check out LF everywhere.
# This pairs with .editorconfig and overrides any local core.autocrlf setting.
* text=auto eol=lf

# Windows batch scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Solution files are written with CRLF by Visual Studio.
*.sln text eol=crlf
*.slnx text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
*.woff binary
*.woff2 binary
